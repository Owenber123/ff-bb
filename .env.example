# BlueBubbles bot configuration.
#
#   cp .env.example .env && chmod 600 .env
#
# Every value here is read from the environment, so systemd/EnvironmentFile,
# a .env file, or plain exports all work. Never commit the real .env.

# ---------------------------------------------------------------------------
# BlueBubbles server
# ---------------------------------------------------------------------------

# Prefer the Tailscale name over the LAN IP: it survives DHCP leases and VLAN
# changes, which the 192.168.x address does not.
#   Tailscale:  http://macbook-pro.tailnet-name.ts.net:1234
#   LAN:        http://192.168.1.67:1234
BB_SERVER_URL=http://macbook-pro.your-tailnet.ts.net:1234

# The BlueBubbles server password. Sent as the ?password= query parameter on
# every request. (`guid` and `token` are accepted aliases; we always use
# `password`.)
BB_PASSWORD=changeme

# Seconds to wait on any single API call. Sends go through AppleScript and take
# roughly 800ms, so do not set this too low.
BB_HTTP_TIMEOUT=20

# ---------------------------------------------------------------------------
# Webhook listener
# ---------------------------------------------------------------------------

BB_LISTEN_HOST=0.0.0.0
BB_LISTEN_PORT=8080

# The path BlueBubbles POSTs to. There is no signature on BlueBubbles webhooks,
# so an unguessable path is a cheap bit of extra safety on a shared LAN.
# Must match the URL you register with `python bot.py webhooks register`.
BB_WEBHOOK_PATH=/webhook

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------

BB_COMMAND_PREFIX=!

# Stamped on every outgoing message as a header line of its own:
#
#     🤖 bloqBot - scores wk17
#     <blank>
#     TKoop 136.6 > charliema 124.3
#
# Three jobs:
#   1. people in the chat can see which messages are automated
#   2. it is a loop guard -- incoming messages carrying this prefix are dropped
#      no matter who sent them, and it pushes any command prefix mid-string
#      where it will not be parsed as a command
#   3. the title says what the message is, so the body does not have to repeat it
#
# Quote it: the trailing space is significant, the title is appended straight
# after. Must not start with BB_COMMAND_PREFIX (startup refuses that outright).
# Set to empty to disable the marker and that loop guard; the command-prefix
# test and the recent-sends tracker still apply, and startup warns.
#
# It costs ~13 of the ~30-column line budget, which is why titles are short
# identifiers ("scores wk17") rather than sentences.
BB_BOT_PREFIX="🤖 bloqBot - "

# Log intended sends instead of calling message/text. Reads still hit the real
# server, so this exercises everything except delivery -- use it to validate
# against your live BlueBubbles server without anything reaching a chat.
BB_DRY_RUN=false

# THE ALLOWLIST. Comma-separated chat GUIDs. The bot replies ONLY in these
# chats. Leaving it empty means the bot replies nowhere -- that is deliberate,
# because the alternative is answering in every conversation on this Apple ID,
# including ones with other people in them.
#
# Get GUIDs with:  python list_chats.py
#   DMs:    iMessage;-;+15551234567
#   Groups: iMessage;+;chat1234567890123456789
BB_ALLOWED_CHATS=

# Escape hatch: reply in EVERY chat on the account. Logs a loud warning at
# startup. Do not leave this on.
BB_ALLOW_ALL_CHATS=false

# When false (default) an unknown command is silently dropped, so the bot stays
# quiet in chats where people use "!" for other things.
BB_REPLY_ON_UNKNOWN_COMMAND=false

# How old (seconds) a message may be and still get a reply. After its Messages
# socket reconnects, the BlueBubbles server re-announces hours of history as
# new-message events -- without this, the bot answers every command in that
# history a second time. Set to 0 to disable the check.
BB_MAX_MESSAGE_AGE_S=300

# ---------------------------------------------------------------------------
# Weekly summary  (python bot.py summary, run from cron)
# ---------------------------------------------------------------------------

# Where the recap is sent. Usually your own DM thread or a family group.
BB_SUMMARY_CHAT=

# Which chats the recap reads from. Defaults to BB_ALLOWED_CHATS when empty.
BB_SUMMARY_SOURCE_CHATS=

BB_SUMMARY_DAYS=7
BB_SUMMARY_TOP_WORDS=10

# Hard cap on messages pulled per run, so a busy week cannot run away.
BB_SUMMARY_MAX_MESSAGES=5000

# ---------------------------------------------------------------------------
# Sleeper / fantasy football
# ---------------------------------------------------------------------------

# The league the fantasy commands read. Sleeper's API is read-only and needs no
# key, so this is the only required value.
#
# Find it without digging through the app:
#     python bot.py sleeper leagues <your-sleeper-username>
#
# Note this is a PER-SEASON id -- Sleeper mints a new league object every year.
# You do not have to update it the moment the new season opens; see
# SLEEPER_FOLLOW_PREVIOUS below.
SLEEPER_LEAGUE_ID=

# Maps chat handles to Sleeper accounts, so "!roast me" and "!record <name>"
# work from whoever sent the message. Never inferred -- fill it in or let people
# run "!link <sleeper name>" in the chat, which writes the same mapping to the
# database.
#
# Format: <handle>=<sleeper display name or user_id>, comma separated.
# Handles are matched loosely, so +1 (555) 123-4567 and +15551234567 are the
# same person. Get the display names and user_ids with:
#     python bot.py sleeper check
#
# SLEEPER_USER_MAP=+15551234567=bloqus,+15559876543=barryyung

# Between seasons your league is "pre_draft": twelve empty rosters, no
# matchups, nothing to show. With this on, the bot falls back to
# previous_league_id so !standings and !roast still work in August, and every
# reply says which season it is showing. Turn it off to have commands answer
# "has not drafted yet" instead.
SLEEPER_FOLLOW_PREVIOUS=true

# Where the SQLite database and the cached Sleeper data live (the player file,
# finished weeks, the NFL schedule). Must be writable by the service user --
# under systemd that means it has to be inside ReadWritePaths=.
# Defaults to <install dir>/data.
# SLEEPER_DATA_DIR=/opt/bluebubbles-bot/data
# SLEEPER_DB_PATH=/opt/bluebubbles-bot/data/bot.db

# Warm the caches in the background at startup: the ~15MB player file, and the
# finished weeks of the season. Without it, the first !standings of the day
# pays for all of that while somebody watches nothing happen.
SLEEPER_PREWARM=true

# ---------------------------------------------------------------------------
# Scheduled posts
# ---------------------------------------------------------------------------
#
# Five bot-initiated messages a week, posted without anybody asking. These are
# what the group will judge the bot on -- they arrive whether or not anyone
# wanted them -- so they are off by default until you have previewed them:
#
#     python bot.py post render recap     print one without sending
#     python bot.py post check            what would fire right now, and why
#
# or in the chat: !preview recap

SLEEPER_POSTS_ENABLED=false

# Which chat receives them. Deliberately separate from BB_ALLOWED_CHATS: the
# bot may answer commands in several chats but should only ever broadcast to
# one. Get the GUID from `python bot.py chats` or !chatinfo.
SLEEPER_POST_CHAT=

# Which of the five are on. Comma separated; omit the line entirely for all
# five. Set it to an explicit empty value to disable them all while leaving
# SLEEPER_POSTS_ENABLED on.
#
#   lineups  Sunday before kickoff, and ONLY if somebody has an empty slot, a
#            starter on bye, or a starter ruled out. Silent when everyone is
#            clean -- a weekly "all good!" trains people to ignore the bot.
#   sunday   Sunday evening once the afternoon games are done. Closest game,
#            worst beating, who is up.
#   recap    After the week's last game ends. Final scores, high, low, and the
#            worst bench decision. The flagship.
#   shotgun  9am the morning after the week's last game (normally Tuesday).
#            Everyone who started a player, DEF included, who scored 0 or
#            less, with a (N) for more than one. Silent if nobody did.
#   ahead    Wednesday morning. Waiver results and this week's matchups.
#
# If the group decides one of them is annoying, remove it here rather than
# turning the whole thing off.
SLEEPER_POST_TYPES=lineups,sunday,recap,shotgun,ahead

# Decides what "Sunday morning" and "Wednesday" mean. Sleeper does not expose a
# league timezone, so this defaults to the NFL's rather than the container's --
# an LXC running UTC would otherwise post the week-ahead on Tuesday evening for
# anybody in the US.
SLEEPER_TIMEZONE=America/New_York

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------

# Minimum seconds between sends. Each send is ~800ms of AppleScript; this stops
# a chatty handler from queueing up behind itself.
BB_SEND_MIN_INTERVAL=1.0

# Worker threads processing webhook events. 2 is plenty -- sends serialise anyway.
BB_WORKER_THREADS=2

# Per-chat rolling history kept in memory. Unused by the current commands; it
# is the seam an AI-backed handler will read from later.
BB_HISTORY_SIZE=50

# Used by !weather when no location is given.
BB_DEFAULT_WEATHER_LOCATION=Brooklyn
# "u" = Fahrenheit/mph, "m" = Celsius/km-h
BB_WEATHER_UNITS=u

# DEBUG dumps every raw webhook payload. That is the first thing to turn on if
# the bot is silent or parsing the wrong fields.
BB_LOG_LEVEL=INFO
# text | json
BB_LOG_FORMAT=text
